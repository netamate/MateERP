# MateERP production frontend image.
# Build a Next.js standalone server so the runtime image contains only the production server output.
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm install --no-audit --no-fund

COPY . .

ARG MATEERP_BACKEND_URL=http://backend:8000
ENV MATEERP_BACKEND_URL=${MATEERP_BACKEND_URL}

RUN npm run build

FROM node:22-alpine AS runner

ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000

WORKDIR /app

COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public

USER node

EXPOSE 3000

LABEL org.opencontainers.image.source="https://github.com/netamate/MateERP"
LABEL org.opencontainers.image.description="MateERP production Next.js frontend"

CMD ["node", "server.js"]
