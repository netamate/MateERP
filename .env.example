# Local development values only. Never commit real secrets.
DJANGO_SECRET_KEY=replace-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://mateerp:mateerp@db:5432/mateerp

# Production hardening toggles. Leave disabled locally.
# Phase 9 should enable SSL redirect after the HTTPS virtual host is validated.
DJANGO_SECURE_SSL_REDIRECT=false
# Keep HSTS at 0 until HTTPS is verified end-to-end, then raise deliberately.
DJANGO_SECURE_HSTS_SECONDS=0

POSTGRES_DB=mateerp
POSTGRES_USER=mateerp
POSTGRES_PASSWORD=mateerp

# Used only by `python manage.py bootstrap_instance`.
MATEERP_BOOTSTRAP_PASSWORD=

# Next.js server-side API proxy destination.
MATEERP_BACKEND_URL=http://backend:8000
