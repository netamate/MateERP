# MateERP production environment template for /opt/MateERP/.env.
# Never commit or paste real production secret values.
MATEERP_BACKEND_IMAGE=ghcr.io/netamate/mateerp-backend:main
MATEERP_FRONTEND_IMAGE=ghcr.io/netamate/mateerp-frontend:main
MATEERP_BACKEND_PORT=8035
MATEERP_FRONTEND_PORT=3035
MATEERP_BACKEND_URL=http://backend:8000

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-strong-production-secret
DJANGO_ALLOWED_HOSTS=erp.netamate.com,localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.netamate.com
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0

POSTGRES_DB=mateerp
POSTGRES_USER=mateerp
POSTGRES_PASSWORD=replace-with-strong-production-password

# Optional MateERP reminder delivery channels.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=MateERP <no-reply@netamate.com>

# Hermes receives clean reminder events by webhook. Leave blank to disable delivery.
MATEERP_HERMES_WEBHOOK_URL=
MATEERP_HERMES_WEBHOOK_TOKEN=


# Optional dedicated Fernet key for encrypting SMTP/Hermes secrets stored through ERP Settings.
# If blank, MateERP derives a stable encryption key from Django SECRET_KEY.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MATEERP_SETTINGS_ENCRYPTION_KEY=
